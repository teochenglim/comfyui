# Copy to .env (`make init` does it). .env is gitignored. Never commit keys.

# --- z.ai (GLM Coding Plan / Pro): LLM prompt expansion -------------------
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-4.7

# --- OpenRouter: video generation (paid credits) + free VLM ---------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0
OPENROUTER_VLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- NVIDIA build (free VLM; no video generation available) ---------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b


# --- Runtime ---------------------------------------------------------------
COMFYUI_PORT=8188
LOG_LEVEL=INFO
INSTALL_MANAGER=false
# Safety: OpenRouter nodes refuse non-:free models unless true (all video models are paid)
OPENROUTER_ALLOW_PAID=false
OPENROUTER_LLM_MODEL=nvidia/nemotron-3.5-lightning:free
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
