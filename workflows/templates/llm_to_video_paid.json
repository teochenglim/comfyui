{
  "_meta": {
    "id": "llm_to_video_paid",
    "description": "PAID: LLM expands the idea, OpenRouter renders real video (default alibaba/wan-3.0 480p 2s \u2248 US$0.10). Needs OPENROUTER_ALLOW_PAID=true.",
    "required_secrets": [
      "OPENROUTER_API_KEY"
    ],
    "overridable_fields": {
      "prompt": [
        "1.inputs.prompt"
      ],
      "provider": [
        "1.inputs.provider"
      ],
      "duration": [
        "2.inputs.duration"
      ],
      "resolution": [
        "2.inputs.resolution"
      ],
      "model": [
        "2.inputs.model"
      ]
    }
  },
  "1": {
    "class_type": "RemoteLLMChat",
    "inputs": {
      "prompt": "a cat surfing a wave at sunset",
      "system_prompt": "You are a cinematic video prompt writer. Expand the idea into one vivid paragraph (<=80 words): subject, motion, camera, lighting, style. Output only the prompt.",
      "provider": "zai",
      "model": "",
      "temperature": 0.7,
      "max_tokens": 2048
    }
  },
  "2": {
    "class_type": "OpenRouterVideo",
    "inputs": {
      "prompt": [
        "1",
        0
      ],
      "model": "",
      "duration": 2,
      "resolution": "480p",
      "aspect_ratio": "16:9",
      "generate_audio": false,
      "timeout_sec": 900
    }
  },
  "3": {
    "class_type": "PreviewAny",
    "inputs": {
      "source": [
        "2",
        0
      ]
    }
  }
}
